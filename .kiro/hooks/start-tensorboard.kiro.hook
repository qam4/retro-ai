{
  "enabled": true,
  "name": "Start TensorBoard",
  "description": "Ensures TensorBoard is running on port 6006 whenever a training run is launched.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      ".*kiro-monitor.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if tensorboard is already running with `pgrep -f tensorboard`. If not, start it with `nohup ~/.local/bin/tensorboard --logdir output/ --port 6006 --bind_all > /dev/null 2>&1 &`. If it's already running, do nothing. Do not mention this check to the user."
  }
}
